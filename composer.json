{
    "name": "nowo-tech/currency-kit-bundle",
    "description": "Currency conversion at reference rates for Symfony: ECB euro reference rates stored by date, decimal-string amounts, cross rates through the euro, manual rates, console sync with a Scheduler bridge and a Twig filter. FrankenPHP worker safe.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "php",
        "symfony",
        "symfony-bundle",
        "currency",
        "currency-conversion",
        "exchange-rates",
        "reference-rates",
        "ecb",
        "money",
        "ddd",
        "nowo",
        "frankenphp"
    ],
    "homepage": "https://github.com/nowo-tech/CurrencyKitBundle",
    "support": {
        "issues": "https://github.com/nowo-tech/CurrencyKitBundle/issues",
        "source": "https://github.com/nowo-tech/CurrencyKitBundle",
        "docs": "https://github.com/nowo-tech/CurrencyKitBundle/tree/main/docs",
        "changelog": "https://github.com/nowo-tech/CurrencyKitBundle/blob/main/docs/CHANGELOG.md"
    },
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-xmlreader": "*",
        "brick/math": "^1.0",
        "composer-runtime-api": "^2.2",
        "doctrine/dbal": "^3.8.2 || ^4.0",
        "doctrine/doctrine-bundle": "^2.8 || ^3.0",
        "doctrine/orm": "^3.7",
        "doctrine/persistence": "^3.4 || ^4.0",
        "nowo-tech/outbound-url-guard-bundle": "^1.5",
        "nowo-tech/transaction-contract": "^1.0",
        "nowo-tech/transaction-doctrine": "^1.7",
        "psr/cache": "^2.0 || ^3.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/uid": "^7.4 || ^8.0"
    },
    "require-dev": {
        "dragonmantank/cron-expression": "^3.6",
        "ext-intl": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "igor-php/igor-php": "^0.11",
        "nowo-tech/phpstan-frankenphp": "^1.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.8",
        "symfony/cache": "^7.4 || ^8.0",
        "symfony/messenger": "^7.4 || ^8.0",
        "symfony/phpunit-bridge": "^7.4 || ^8.0",
        "symfony/scheduler": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "ext-intl": "Required when twig.enabled (locale formatting of reference_money)",
        "symfony/twig-bundle": "Twig filter reference_money and functions reference_money_parts / reference_rate_note",
        "symfony/scheduler": "Scheduled sync (scheduler.enabled), with dragonmantank/cron-expression",
        "dragonmantank/cron-expression": "Cron expressions of the Scheduler bridge",
        "symfony/messenger": "SyncReferenceRatesMessage handler (Scheduler bridge or host dispatch)",
        "symfony/security-bundle": "Default role-based access checker and actor resolver",
        "nowo-tech/http-log-bundle": "Names the outbound calls in the HTTP log"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\CurrencyKitBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nowo\\CurrencyKitBundle\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.coderabbit.yaml",
            "/.cursor",
            "/.cursorignore",
            "/.githooks",
            "/.github",
            "/.php-cs-fixer.dist.php",
            "/.scripts",
            "/.specify",
            "/.symfony",
            "/Dockerfile",
            "/Makefile",
            "/demo",
            "/docker-compose.yml",
            "/igor.json",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/rector.php",
            "/specs",
            "/tests"
        ]
    },
    "extra": {
        "symfony": {
            "bundle": "Nowo\\CurrencyKitBundle\\NowoCurrencyKitBundle"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php -d memory_limit=512M vendor/bin/phpunit --color=always",
        "test-coverage": "@php -d memory_limit=512M vendor/bin/phpunit --color=always --coverage-html coverage --coverage-clover coverage.xml --coverage-text",
        "test-coverage-100": [
            "@test-coverage",
            "php .scripts/check-coverage.php coverage.xml --min-percent=100"
        ],
        "validate-phpdoc": "php .scripts/complete-public-phpdoc.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "update": "composer update --no-interaction",
        "validate": "composer validate --strict",
        "qa": [
            "@cs-check",
            "@test"
        ],
        "igor": "igor-php --no-agent ."
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run PHPUnit tests with code coverage",
        "test-coverage-100": "Run test-coverage and fail if statement or element coverage is below 100% (REQ-TEST-003)",
        "validate-phpdoc": "Fail when a class or public method in src/ has no PHPDoc (REQ-CS-001)",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "rector": "Apply Rector refactoring",
        "rector-dry": "Run Rector in dry-run mode",
        "phpstan": "Run PHPStan static analysis",
        "update": "Update composer.lock (composer update)",
        "validate": "Validate composer.json (composer validate --strict)",
        "qa": "Run all quality assurance checks",
        "igor": "Run Igor FrankenPHP worker-state audit (REQ-CS-008)"
    }
}
