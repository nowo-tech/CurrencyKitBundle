<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Twin of the attributes on ReferenceRate (a test asserts both give the same schema). Read-only: written through DBAL. -->
    <entity name="Nowo\CurrencyKitBundle\Infrastructure\Doctrine\Entity\ReferenceRate" table="currency_rate" read-only="true">
        <indexes>
            <index name="currency_rate_source_currency_date_idx" columns="source,currency,rate_date"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="currency_rate_source_date_currency_uniq" columns="source,rate_date,currency"/>
        </unique-constraints>
        <id name="id" type="string" column="id" length="36">
            <options>
                <option name="fixed">true</option>
            </options>
        </id>
        <field name="source" type="string" column="source" length="32"/>
        <field name="rateDate" type="date_immutable" column="rate_date"/>
        <field name="currency" type="string" column="currency" length="3">
            <options>
                <option name="fixed">true</option>
            </options>
        </field>
        <field name="rate" type="decimal" column="rate" precision="24" scale="12"/>
        <field name="publicationId" type="string" column="publication_id" length="36">
            <options>
                <option name="fixed">true</option>
            </options>
        </field>
    </entity>
</doctrine-mapping>
