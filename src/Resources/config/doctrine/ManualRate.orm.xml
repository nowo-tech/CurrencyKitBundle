<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Twin of the attributes on ManualRate (a test asserts both give the same schema). Read-only: written through DBAL. -->
    <entity name="Nowo\CurrencyKitBundle\Infrastructure\Doctrine\Entity\ManualRate" table="currency_manual_rate" read-only="true">
        <indexes>
            <index name="currency_manual_rate_currency_status_from_idx" columns="currency,status,valid_from"/>
        </indexes>
        <id name="id" type="string" column="id" length="36">
            <options>
                <option name="fixed">true</option>
            </options>
        </id>
        <field name="currency" type="string" column="currency" length="3">
            <options>
                <option name="fixed">true</option>
            </options>
        </field>
        <field name="rate" type="decimal" column="rate" precision="24" scale="12"/>
        <field name="validFrom" type="date_immutable" column="valid_from"/>
        <field name="validUntil" type="date_immutable" column="valid_until" nullable="true"/>
        <field name="reason" type="string" column="reason" length="500"/>
        <field name="status" type="string" column="status" length="8"/>
        <field name="createdBy" type="string" column="created_by" length="128" nullable="true"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="updatedBy" type="string" column="updated_by" length="128" nullable="true"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>
        <field name="version" type="integer" column="version"/>
    </entity>
</doctrine-mapping>
